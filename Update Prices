name: Update Prices
on:
  schedule:
    - cron: '*/5 * * * *'  # 每5分鐘更新一次
  workflow_dispatch:

jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - run: pip install yfinance
      - run: |
          python -c "
          import yfinance as yf, json
          codes = ['0700.HK','0005.HK','2800.HK','0001.HK','0388.HK']
          data = {}
          for c in codes:
              try:
                  h = yf.Ticker(c).history(period='2d')
                  data[c] = {'close': float(h['Close'].iloc[-1]), 'open': float(h['Open'].iloc[-1]), 'high': float(h['High'].iloc[-1]), 'low': float(h['Low'].iloc[-1])}
              except:
                  pass
          import datetime
          data['_time'] = datetime.datetime.now().isoformat()
          open('prices.json','w').write(json.dumps(data))
          "
      - run: |
          git config user.name bot
          git config user.email bot@bot.com
          git add prices.json
          git commit -m "update price" || true
          git push
